%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 28, "rankSpacing": 50}, "themeVariables": {"fontSize": "13px"}}}%%
flowchart LR
  classDef src fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.2px,color:#1e3a8a;
  classDef proc fill:#dcfce7,stroke:#166534,stroke-width:1.2px,color:#14532d;
  classDef rule fill:#ecfccb,stroke:#3f6212,stroke-width:1.2px,color:#365314;
  classDef exec fill:#fee2e2,stroke:#991b1b,stroke-width:1.2px,color:#7f1d1d;
  classDef store fill:#e0e7ff,stroke:#4338ca,stroke-width:1.2px,color:#312e81;
  classDef sink fill:#f4f4f5,stroke:#52525b,stroke-width:1.2px,color:#27272a;
  classDef sched fill:#fef9c3,stroke:#a16207,stroke-width:1.2px,color:#713f12;

  sched(["APScheduler<br/>10:30 + 15:30 ET<br/>RTH gate · Mon–Fri<br/><i>trader.main</i>"]):::sched

  subgraph SRC["1 · Inputs"]
    direction TB
    funds["Fund universe<br/>core · dividend · growth<br/>funds.yaml"]:::src
    aMD["Alpaca Market Data<br/>prior close → last"]:::src
    aTR["Alpaca Trading API<br/>equity · cash · positions"]:::src
  end

  subgraph PIPE["2 · Rules (no LLM)"]
    direction TB
    red["Per-ticker red check<br/>day return &lt; 0"]:::rule
    sleeve["Sleeve underweight?<br/>50% / 25% / 25%"]:::proc
    dedupe["Already bought<br/>this sleeve today?"]:::proc
    buy["Market buy<br/>~5% equity notional"]:::exec
    hold["Skip / HOLD"]:::proc
  end

  subgraph SINK["3 · Sinks"]
    direction TB
    alp["Alpaca paper<br/>fills + book"]:::sink
    db[("SQLite journal")]:::store
    jsl[("JSONL mirror")]:::store
    web["Operator dashboard<br/>cycles · positions"]:::sink
  end

  sched --> funds
  funds --> red
  aMD --> red
  aTR --> sleeve
  red -->|green| hold
  red -->|red| sleeve
  sleeve -->|no| hold
  sleeve -->|yes| dedupe
  dedupe -->|yes| hold
  dedupe -->|no| buy
  buy --> alp
  buy --> db
  hold --> db
  db --> jsl
  db --> web
